PORT=3000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=1d
ALLOW_PUBLIC_REGISTRATION=true
FRONTEND_ORIGINS=http://localhost:5500
FRONTEND_URL=http://localhost:5500
PASSWORD_RESET_EXPIRES_MINUTES=60
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=planeja_plus

# SMTP para envio dos links de redefinicao. Sem SMTP, em desenvolvimento,
# o link de redefinicao aparece no terminal da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Planeja+ <nao-responda@seudominio.com>