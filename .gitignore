# Arquivos e pastas que nao devem ser enviados para o repositorio.

# Dependencias instaladas pelo npm; podem ser recriadas com npm install.
node_modules/
**/node_modules/

# Variaveis de ambiente com senhas, tokens e configuracoes locais.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Arquivos de log gerados por ferramentas de desenvolvimento.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Pastas de build geradas em processos de producao.
dist/
build/
**/dist/
**/build/

# Relatorios de cobertura de testes.
coverage/
**/coverage/

# Arquivos criados pelo sistema operacional ou por editores.
.DS_Store
Thumbs.db
.vscode/
.idea/

# Arquivos temporarios de execucao.
*.pid
*.seed
*.pid.lock

# Bancos SQLite locais; arquivos ja versionados precisam ser removidos do Git
# separadamente, depois de criar e verificar uma copia de seguranca.
backend/database/*.sqlite
backend/database/*.sqlite-*
